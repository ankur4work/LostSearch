{%- comment -%}
  DemandRadar Storefront Tracker — app embed block.

  Once a merchant installs DemandRadar and enables this embed in their theme
  editor (Theme → App embeds → toggle "DemandRadar Storefront Tracker"), the
  script below loads on every page and captures every storefront search:
  what shoppers typed, how many results came back, whether they clicked.

  No PII is captured — only the query string, result count, and a timestamp.
  See https://demandradar.solnix.store/methodology for full details.
{%- endcomment -%}

{% if block.settings.enabled %}
  <script
    src="https://demandradar.solnix.store/tracker.js"
    defer
    data-demandradar="storefront-tracker"
  ></script>
{% endif %}

{% schema %}
{
  "name": "DemandRadar Tracker",
  "target": "head",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable storefront search tracking",
      "default": true,
      "info": "Captures shopper search queries to surface revenue gaps. Required for DemandRadar to work."
    }
  ]
}
{% endschema %}
